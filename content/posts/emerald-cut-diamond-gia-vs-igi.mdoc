<th>Verdict for Emerald Cut in Platinum</th>
</tr>
</thead>
<tbody>
<tr><td>D</td><td>F–G</td><td>E–F</td><td>Safe — looks white</td></tr>
<tr><td>E</td><td>G–H</td><td>F–G</td><td>Safe — acceptable in cool metal</td></tr>
<tr><td>F</td><td>H–I</td><td>G–H</td><td>Borderline — visible warmth risk</td></tr>
<tr><td>G</td><td>I–J</td><td>H–I</td><td>Avoid — warm in platinum/white gold</td></tr>
</tbody>
</table>

