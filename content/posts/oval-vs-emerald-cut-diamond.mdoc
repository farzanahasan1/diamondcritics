<tr><td>0.50ct</td><td>5.2mm</td><td>~6.5×4.5mm</td><td>~5.5×4.0mm</td></tr>
<tr><td>1.00ct</td><td>6.4mm</td><td>~8.5×5.5mm</td><td>~6.5×5.0mm</td></tr>
<tr><td>1.50ct</td><td>7.3mm</td><td>~9.5×6.5mm</td><td>~7.5×5.5mm</td></tr>
<tr><td>2.00ct</td><td>8.1mm</td><td>~10.5×7.0mm</td><td>~8.5×6.0mm</td></tr>
