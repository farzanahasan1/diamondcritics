{
  "crons": [
    {
      "path": "/api/cron/cleanup-community-images",
      "schedule": "0 3 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://madebyevoke.com https://*.claude-5k5.pages.dev"
        }
      ]
    }
  ]
}
